cat <<EOF > vpc-restriction-policy.json
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowFromVPCE",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:SourceVpce": "$VPCE_ID"
        }
      }
    }
  ]
}
EOF
